# ElectronIx Trace — edge configuration example. Copy to .env and edit.
# NEVER commit a real .env.

TRACE_DATABASE_URL=postgres://trace_app:change_me@127.0.0.1:5432/trace_dev
TRACE_BIND_ADDR=0.0.0.0:8080

# Per-plant, printed into every QR. Not a constant — see spec section 6.
TRACE_BASE_URL=http://trace.plant.local

# --- Licensing / entitlements (edge side: PUBLIC key only) ---
# The edge box verifies signatures. It must never hold a signing key.
TRACE_LICENSE_PUBKEY_HEX=

# --- OTA (edge side: PUBLIC key only) ---
TRACE_UPDATE_PUBKEY_HEX=
TRACE_UPDATE_MANIFEST_URL=

# --- Stripe (CONTROL PLANE ONLY — never set these on a factory edge box) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
